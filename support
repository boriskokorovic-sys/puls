  function pick() {
    var h = (location.hash || '').slice(1).toLowerCase();
    if (langs.indexOf(h) >= 0) return h;
    var nav = (navigator.languages || [navigator.language || 'en']).map(function (l) { return String(l).slice(0, 2).toLowerCase(); });
    for (var i = 0; i < nav.length; i++) if (langs.indexOf(nav[i]) >= 0) return nav[i];
    return 'en';
  }
  function show() {
    var l = pick();
    langs.forEach(function (x) {
      var s = document.getElementById(x);
      s.className = 'lang' + (x === l ? ' on' : '');
    });
    var on = document.getElementById(l);
    document.documentElement.lang = l;
    document.getElementById('title').textContent = on.getAttribute('data-title');
    document.title = 'Puls · ' + on.getAttribute('data-title');
    Array.prototype.forEach.call(document.querySelectorAll('#langs a'), function (a) {
      a.setAttribute('aria-current', a.getAttribute('href') === '#' + l ? 'true' : 'false');
    });
  }
  // The language chips are links to #xx; keep the page at the top instead of jumping to the section.
  window.addEventListener('hashchange', function () { show(); window.scrollTo(0, 0); });
  show();
  window.addEventListener('load', function () { window.scrollTo(0, 0); });
})();
